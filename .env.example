DATABASE_URL=postgresql://knight_frank:local_dev_password@127.0.0.1:5432/knight_frank
# Optional direct connection for Prisma migrations when using Neon.
# Keep DATABASE_URL pooled for application queries.
DATABASE_URL_UNPOOLED=
# Server-only Neon Object Storage settings, populated by neon env pull -s object-storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
POSTGRES_USER=knight_frank
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=knight_frank
POSTGRES_PORT=5432
DEMO_EMAIL=investor@example.com
DEMO_PASSWORD=KnightFrank2026!
# Demo owner created by the database seed. Existing passwords are preserved.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=KnightFrankAdmin2026!
BETTER_AUTH_URL=http://127.0.0.1:3000
# Run npm run env:setup to generate a local secret automatically.
BETTER_AUTH_SECRET=
# Server-only. Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
